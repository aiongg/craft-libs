{
  "schema": "craft-design-theme",
  "schema_version": 1,
  "id": "craft.classic",
  "name": "Classic",
  "version": 1,
  "variants": "light",
  "contrast_intent": "standard",
  "seeds": {
    "accent": "#0a246a",
    "neutral": "#d4d0c8",
    "status": {
      "bad": "#a00000",
      "good": "#4e712e",
      "info": "#0a246a",
      "warn": "#806000"
    }
  },
  "shape": {
    "edge": {
      "bevel": {
        "width": 1.0
      }
    },
    "radius": {
      "button": 0.0,
      "control": 0.0,
      "panel": 0.0,
      "pill": 0.0,
      "popup": 0.0,
      "window": 0.0
    }
  },
  "light": {
    "accent.soft": "{accent.solid}",
    "accent.solid": "#0a246a",
    "button.default_frame": "{text.normal}",
    "button.primary.fill.hover": "{button.primary.fill.rest}",
    "button.primary.fill.pressed": "{button.primary.fill.rest}",
    "button.primary.fill.rest": "{surface.background}",
    "button.primary.text.hover": "{button.primary.text.rest}",
    "button.primary.text.pressed": "{button.primary.text.rest}",
    "button.primary.text.rest": "{text.normal}",
    "button.secondary.border.pressed": "{edge.dark}",
    "button.secondary.fill.hover": "{surface.background}",
    "button.secondary.fill.pressed": "{state.pressed}",
    "button.secondary.fill.rest": "{surface.background}",
    "button.secondary.text.pressed": "{text.normal}",
    "caption.close_hover": "#c42b1c",
    "caption.close_text": "#ffffff",
    "check.on.border.disabled": "{check.off.border.disabled}",
    "check.on.border.hover": "{check.off.border.hover}",
    "check.on.border.pressed": "{check.off.border.pressed}",
    "check.on.border.rest": "{check.off.border.rest}",
    "check.on.fill.disabled": "{surface.background}",
    "check.on.fill.hover": "{check.on.fill.rest}",
    "check.on.fill.pressed": "{check.off.fill.pressed}",
    "check.on.fill.rest": "{surface.sunken}",
    "check.on.mark.disabled": "#808080",
    "check.on.mark.hover": "{check.on.mark.rest}",
    "check.on.mark.pressed": "{check.on.mark.rest}",
    "check.on.mark.rest": "{text.normal}",
    "check.switch.border.hover": "{accent.solid}",
    "check.switch.border.pressed": "{accent.solid}",
    "check.switch.border.rest": "{accent.solid}",
    "check.switch.fill.hover": "{accent.solid}",
    "check.switch.fill.pressed": "{accent.solid}",
    "check.switch.fill.rest": "{accent.solid}",
    "edge.dark": "#404040",
    "edge.light": "#ffffff",
    "line.border": "#808080",
    "line.control_edge": "{line.border}",
    "line.divider": "{line.border}",
    "listbox.active.fill": "{state.selected}",
    "listbox.active.text": "{text.on_selected}",
    "slider.ring.hover": "#00000000",
    "slider.ring.pressed": "{slider.ring.hover}",
    "state.hover": "#e2ded6",
    "state.pressed": "#bebab2",
    "state.selected": "{accent.solid}",
    "state.selected_hover": "{accent.solid}",
    "surface.background": "#d4d0c8",
    "surface.canvas": "#808080",
    "surface.knob": "{surface.background}",
    "surface.panel": "{surface.background}",
    "surface.raised": "{surface.background}",
    "surface.sunken": "#ffffff",
    "text.disabled": "#808080",
    "text.faint": "#808080",
    "text.muted": "#404040",
    "text.normal": "#000000",
    "text.on_selected": "{text.on_accent}",
    "toggle_button.on.border": "{edge.dark}",
    "toggle_button.on.fill": "{state.pressed}",
    "toggle_button.on.text": "{text.normal}",
    "toggle_button.on_disabled.fill": "{state.pressed}",
    "tooltip.border": "{text.normal}",
    "tooltip.fill": "#ffffe1",
    "tooltip.text": "{text.normal}"
  },
  "components": {
    "slider.thumb_height": 16.0,
    "slider.thumb_width": 10.0
  }
}
