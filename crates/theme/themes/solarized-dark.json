    "listbox.chosen.text": "{text.normal}",
    "state.hover": "#0e4a5a",
    "state.pressed": "#12596b",
    "surface.background": "#00252f",
    "surface.canvas": "#002b36",
    "surface.canvas_pattern": "#0a3d4a",
    "surface.panel": "#073642",
    "surface.sunken": "#00252f",
    "text.faint": "#586e75",
    "text.muted": "#657b83",
    "text.normal": "#839496",
