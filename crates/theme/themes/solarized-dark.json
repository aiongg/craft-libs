{
  "schema": "craft-design-theme",
  "schema_version": 1,
  "id": "craft.solarized-dark",
  "name": "Solarized Dark",
  "version": 1,
  "variants": "dark",
  "contrast_intent": "standard",
  "seeds": {
    "accent": "#268bd2",
    "neutral": "#073642",
    "status": {
      "bad": "#dc322f",
      "good": "#85dc6a",
      "info": "#268bd2",
      "warn": "#b58900"
    }
  },
  "shape": null,
  "dark": {
    "accent.border": "#268bd278",
    "accent.soft": "#268bd22e",
    "accent.solid": "#268bd2",
    "button.primary.text.rest": "#fdf6e3",
    "caption.close_hover": "#dc322f",
    "caption.close_text": "#fdf6e3",
    "data.scope": "#002b36",
    "icon_button.selected.text": "#fdf6e3",
    "line.border": "#00252f",
    "line.control_edge": "#15505f",
    "line.divider": "#00252f",
    "list.layer.outline": "{line.control_edge}",
